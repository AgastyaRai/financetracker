DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/financetracker
JWT_SECRET=replace-with-a-long-random-secret
OPENAI_API_KEY=replace-with-your-openai-api-key
PORT=3000

# Uncomment to run database migrations automatically when the backend starts.
# RUN_MIGRATIONS=1

# Optional Plaid Sandbox linking. All three settings are required to enable the endpoint.
# Choose comma-separated country codes for the institutions you want to test (e.g. US,CA).
# PLAID_CLIENT_ID=your-plaid-client-id
# PLAID_SANDBOX_SECRET=your-plaid-sandbox-secret
# PLAID_COUNTRY_CODES=US,CA

# Optional bank credential encryption. Leave unset when encrypted credential storage is not configured.
# Use standard padded Base64 encoding of exactly 32 random bytes, with no surrounding whitespace.
# A supplied invalid value prevents backend startup.
# Keep the same key across restarts and deployments so saved credentials remain readable.
# BANK_CREDENTIAL_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
